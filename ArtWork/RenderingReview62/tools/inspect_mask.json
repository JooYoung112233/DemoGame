{"code":"return Newtonsoft.Json.JsonConvert.SerializeObject(UnityEngine.Object.FindObjectsByType<NPCController>(FindObjectsSortMode.None).Select(n=>{var m=n.GetComponentInChildren<SkinnedMeshRenderer>().sharedMaterial;return new{id=n.Data.npcId,mat=m.name,shader=m.shader.name,mask=UnityEditor.AssetDatabase.GetAssetPath(m.GetTexture(\"_MetallicGlossMap\")),use=m.GetFloat(\"_UsePackedMask\"),metal=m.GetFloat(\"_Metallic\"),smooth=m.GetFloat(\"_Smoothness\"),keywords=m.shaderKeywords};}).ToArray());","timeout":30000}
