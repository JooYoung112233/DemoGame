{"code":"var shader=Shader.Find(\"BRB/GameLit\");return Newtonsoft.Json.JsonConvert.SerializeObject(new{playing=UnityEditor.EditorApplication.isPlaying,shaderErrors=UnityEditor.ShaderUtil.GetShaderMessages(shader).Select(m=>new{severity=m.severity.ToString(),m.message}).ToArray(),postControllers=UnityEngine.Object.FindObjectsByType<PostProcessController>(FindObjectsSortMode.None).Select(p=>new{name=p.name,enabled=p.enabled}).ToArray(),dayNight=UnityEngine.Object.FindObjectsByType<DayNightCycle>(FindObjectsSortMode.None).Select(d=>new{d.IsNight}).ToArray(),npc=UnityEngine.Object.FindObjectsByType<NPCController>(FindObjectsSortMode.None).Select(n=>new{id=n.Data.npcId,loop=n.GetComponentInChildren<Animator>().GetCurrentAnimatorStateInfo(0).loop,mask=UnityEditor.AssetDatabase.GetAssetPath(n.GetComponentInChildren<SkinnedMeshRenderer>().sharedMaterial.GetTexture(\"_MetallicGlossMap\"))}).ToArray(),player=GameObject.FindGameObjectWithTag(\"Player\").transform.position.ToString()});","timeout":30000}
