{"code":"var p=GameObject.FindGameObjectWithTag(\"Player\");var n=UnityEngine.Object.FindObjectsByType<NPCController>(FindObjectsSortMode.None).Single(n=>n.Data.npcId==\"pawnshop\");var cc=p.GetComponent<CharacterController>();bool en=cc!=null&&cc.enabled;if(en)cc.enabled=false;p.transform.position=new Vector3(n.transform.position.x,0,n.transform.position.z-1.8f);if(en)cc.enabled=true;CameraFollow.Instance?.SnapToTarget();return Newtonsoft.Json.JsonConvert.SerializeObject(new{player=p.transform.position.ToString(),camera=Camera.main.transform.position.ToString(),components=p.GetComponents<Component>().Select(c=>c.GetType().Name).ToArray()});","timeout":30000}
