    {"key": "UI_DAILY_UNLOCKED", "value": "폐상가 교역 지구를 자유롭게 탐색할 수 있습니다."},
    {"key": "UI_MAP_LOCKED", "value": "거긴 아직 위험해. 좀 더 준비하고."}
  ]
}
