{
  "entries": [
    {"key": "NPC_PAWNSHOP", "value": "전당포 주인"},
    {"key": "NPC_PLAYER", "value": "주인공"},
    {"key": "NPC_VETERAN", "value": "회수꾼"},
    {"key": "NPC_MANAGER", "value": "구역 관리인"},
    {"key": "NPC_MERCHANT", "value": "떠돌이 상인"},
    {"key": "NPC_HOSTILE", "value": "탐색꾼"},
    {"key": "NPC_BANDIT", "value": "밴딧 잔당"},
    {"key": "NPC_SURVIVOR", "value": "갇힌 생존자"},
    {"key": "NPC_NEGOTIATOR", "value": "밴딧 협상꾼"},
    {"key": "NPC_VENDOR", "value": "노점상"},

    {"key": "TUT_MOVE", "value": "WASD — 이동"},
    {"key": "TUT_INVENTORY", "value": "Tab — 인벤토리"},
    {"key": "TUT_HOTKEY", "value": "1~5 — 아이템 단축 사용 (각목 = 무기 슬롯)"},
    {"key": "TUT_SEARCH", "value": "E — 수색"},
    {"key": "TUT_WEIGHT", "value": "가방이 가득 찼습니다. 덜 중요한 건 버리거나 골라 담으세요."},
    {"key": "TUT_COMBAT", "value": "좌클릭 — 약공격 / 우클릭(홀드) — 강공격 / Space — 구르기"},
    {"key": "TUT_STASH", "value": "Tab — 장비 & 창고. 값나가는 건 창고에, 쓸모없는 건 버리세요."},
    {"key": "TUT_REST", "value": "침상에서 휴식 → 체력·기력 회복 (허기·수분 소모)"},
    {"key": "TUT_SURVIVAL", "value": "허기·수분이 떨어지면 위험합니다. 먹고 마실 것을 구하세요."},
    {"key": "TUT_SHOP", "value": "잡템을 팔아 정크를 모으고, 물·통조림을 사세요."},
    {"key": "TUT_FLASHLIGHT", "value": "F — 손전등 / 마우스 — 빛 방향. 빛이 닿는 곳만 보입니다."},
    {"key": "TUT_HELP", "value": "H — 조작법 보기"},

    {"key": "S000_N01", "value": "……머리가 아프다. 여기가 어디지?"},
    {"key": "S000_N02", "value": "……시계? 이게 내 건가."},
    {"key": "S000_N03", "value": "아무것도 기억이 안 난다."},

    {"key": "S001_N01", "value": "비가 그치질 않는다."},
    {"key": "S001_N02", "value": "비를 피해, 지친 몸을 누일 곳이 필요하다."},
    {"key": "S001_N03", "value": "비어있는 가방엔 도움 될 물건은 없어 보인다."},
    {"key": "S001_N04", "value": "손목의 시계가 눈에 들어온다."},

    {"key": "S002_N01", "value": "여기라면…… 이 시계를 받아줄지도."},
    {"key": "S002_D01", "value": "……뭐야. 이 시간에."},
    {"key": "S002_D02", "value": "뭐가 필요해서 왔나?"},
    {"key": "S002_D03", "value": "여긴 적선하는 데 아니야."},
    {"key": "S002_D04", "value": "이거…… 값이 됩니까?"},
    {"key": "S002_D05", "value": "이게…… 이거, 어디서 났어."},
    {"key": "S002_D06", "value": "잘 모릅니다."},
    {"key": "S002_D07", "value": "이 시계는 못 받아. 다른 거 없어?"},
    {"key": "S002_D08", "value": "가진 게 없습니다. 혹시…… 그렇다면 잠시 비를 피할 곳을 알려주실 수 있습니까?"},
    {"key": "S002_D09", "value": "……밖에. 우측으로 가면, 길바닥에 사람이 하나 있을 거야."},
    {"key": "S002_D10", "value": "거기서 '새벽'이라고 말해."},
    {"key": "S002_D11", "value": "새벽이요? 그게 무슨 말이죠?"},
    {"key": "S002_D12", "value": "나가. 장사 방해하지 말고."},

    {"key": "S003_N01", "value": "……저 사람인가."},
    {"key": "S003_D01", "value": "……누구야?"},
    {"key": "S003_D02", "value": "새벽."},
    {"key": "S003_D03", "value": "……'새벽'이라. 전당포 영감이 보냈나 보군."},
    {"key": "S003_D04", "value": "일이 필요하냐?"},
    {"key": "S003_D05", "value": "네……."},
    {"key": "S003_D06", "value": "한번 살펴봐. 의뢰는 많지만, 네가 지금 할 수 있는 건…… 간단 의뢰 뿐이겠네."},
    {"key": "S003_D07", "value": "나머진 이름값부터 쌓고 와. 검증 안 된 신참한텐 안 맡겨."},
    {"key": "S003_D08", "value": "……궁금한 거 있으면 물어봐. 말할 수 있는 선에선 대답해주지."},
    {"key": "S003_C01", "value": "루디?"},
    {"key": "S003_R01", "value": "……어디 벙커에 있었다 왔나? 그럼 짙은 현상에 대해서도 모르겠네?"},
    {"key": "S003_R02", "value": "어디서부터 설명해야 할지…… 도시 곳곳을 갉아먹는 기이한 현상이 있어. 빛이고 길이고, 닿는 족족 일그러지지."},
    {"key": "S003_R03", "value": "한번 잡아먹힌 데는 한낮에도 코앞이 안 보여. 밤도 아닌데 밤 같지."},
    {"key": "S003_R04", "value": "루디는 그 속에서 나오는 돌이야. 빛이 나는데, 그 빛만은 현상을 안 건드려."},
    {"key": "S003_R05", "value": "전기 끊긴 뒤로 유일하게 믿을 동력이지. 다들 목숨 걸고 줍는 거고. 일단 여기까지만 알고 있으면 돼."},
    {"key": "S003_C02", "value": "어디로 가야 합니까?"},
    {"key": "S003_R06", "value": "어디 보자…… 제일 가까운 데가 폐상가 공터 부근이네."},
    {"key": "S003_R07", "value": "지금은 폐허일 뿐이지만, 현상이 짙어지면 — 우린 그 꼴을 '밤'이라 불러 — 없던 게 생겨."},
    {"key": "S003_R08", "value": "시간 얘기가 아니야. 그 동네가 현상에 잡아먹혀 컴컴해지는 거지. 루디도 그때 나오고."},
    {"key": "S003_C03", "value": "위험합니까?"},
    {"key": "S003_R09", "value": "생존은... 장담 못 해. 다 먹고 살자고 가는 거지."},
    {"key": "S003_R10", "value": "하나 충고하자면, 무턱대고 밤에 지역을 가면 시체되기 딱 좋아."},
    {"key": "S003_R11", "value": "낮에 먼저 가서 지형과 환경부터 파악해. 밤은 그 다음이야."},
    {"key": "S003_D09", "value": "옆에 보이는 게시판에서 폐상가 의뢰서 하나 떼 와. 갈 곳이랑 할 일, 언제 가야 할지, 거기 다 적혀 있어."},

    {"key": "S004_NOTE", "value": "[아이를 찾아 주세요]\n\n찾고 있는 아이가 있습니다.\n이름은…… 잘 모릅니다. 다들 그냥 '민이'라고 불렀어요.\n작고, 잘 울고, 무서우면 숨어요.\n혹시 흔적을 찾으면, 게시판에 이 의뢰서와 함께 표시를 남겨 주세요.\n보상은 제가 가진 건 전부 두고 갑니다.\n\n- 수아 -"},
    {"key": "S004_N01", "value": "……할 수 있는 건 이거 하나뿐이군."},
    {"key": "S004_D01", "value": "뗐어? ……근데 너, 그 꼴로 가게?"},
    {"key": "S004_D02", "value": "맨손에 의약품도 없이 들어가면, 아무리 낮이라고 해도 탐색꾼들에게 걸리면 뼈도 못 찾는다."},
    {"key": "S004_D03", "value": "받아. 무기로 쓸 나무 각목이랑 의료템 몇 개."},
    {"key": "S004_D04", "value": "오랜만에 신참이니 이 정도 투자는 해주지. 다만, 이번 한 번만이야. 다음은 없어."},
    {"key": "S004_D05", "value": "앞으로 장비는 알아서 구하고."},
    {"key": "S004_D06", "value": "준비됐으면 옆에 보이는 큰 문으로 가면 돼."},
    {"key": "S004_D07", "value": "지금 거기는…… 낮이겠군. 살아서 보자고, 신참."},

    {"key": "S005_N01", "value": "여기가 폐상가…… 다 부서졌다."},
    {"key": "S005_N02", "value": "민이라는 아이를 찾으라고 했지. ……어디서부터 봐야 하나."},
    {"key": "S005_N03", "value": "쓸 만한 건…… 챙겨두자."},
    {"key": "S005_N04", "value": "다 담을 순 없다. ……값나가는 것부터."},
    {"key": "S005_B01", "value": "……어이. 거기서 뭐 해."},
    {"key": "S005_B02", "value": "그 가방 내려놓고 꺼져. 안 그럼——"},
    {"key": "S005_N05", "value": "……죽이지 않으면, 내가 죽는다."},
    {"key": "S005_N06", "value": "바깥은…… 그런 곳이군."},
    {"key": "S005_N07", "value": "창고문을 여니, 문 아래쪽에 작은 손자국이 말라붙어 있다."},
    {"key": "S005_N08", "value": "안에서 누가 긁은 것 같은 자국도 보인다."},
    {"key": "S005_NOTE", "value": "세 번 두드리면 대답해.\n한 번이면 숨고.\n두 번이면 울고.\n네 번이면 절대 열지 마."},
    {"key": "S005_N09", "value": "민이…… 실제로 여기 있었던 것 같다."},
    {"key": "S005_N10", "value": "지금은 어디 있지?"},

    {"key": "S006_N01", "value": "창고 앞에 맨홀이 열려 있다."},
    {"key": "S006_N02", "value": "……일단 빠져나가자. 민이 일은, 돌아가서 알려야겠다."},

    {"key": "S007_D01", "value": "……살아서 돌아왔구만."},
    {"key": "S007_D02", "value": "그래, 의뢰는?"},
    {"key": "S007_D03", "value": "……아이 흔적을 찾았습니다. 폐상가 창고에."},
    {"key": "S007_D04", "value": "안에서 긁은 자국이랑…… 벽에 흐릿한 글씨가 있었습니다."},
    {"key": "S007_D05", "value": "....규칙이군. 부모나 보호자가 나갈 때 아이를 보호하기 위한 수단 중 하나이지."},
    {"key": "S007_D06", "value": "아이는 죽었나?"},
    {"key": "S007_D07", "value": "아이 시체는 따로 없었습니다.."},
    {"key": "S007_D08", "value": "근데, 민이를 아십니까?"},
    {"key": "S007_D09", "value": "민이? 처음 듣는데. 의뢰서에 적힌 이름인가 보지?"},
    {"key": "S007_D10", "value": "누구인지, 나도 몰라. 의뢰서 받을 때 묻지도 않고."},
    {"key": "S007_D11", "value": "평범한 일상이지. 여기선 다들 누군가를 찾아. ……대부분 시체지."},
    {"key": "S007_D12", "value": "흔적 찾았으면 저 의뢰서에 표시 남겨. 의뢰자가 확인할 거다."},
    {"key": "S007_D13", "value": "보수는…… 의뢰자가 두고 간 거. 많진 않아. 받아."},
    {"key": "S007_D14", "value": "……근데 너, 이름이 뭐야?"},
    {"key": "S007_D15", "value": "……모릅니다. 기억이 없습니다."},
    {"key": "S007_D16", "value": "하. 여기 딱 어울리는 놈이군."},
    {"key": "S007_D17", "value": "그럼 '새벽'이라고 불러도 되나?"},
    {"key": "S007_D18", "value": "상관 없습니다..."},
    {"key": "S007_D19", "value": "'새벽'. 이름을 찾기 전까진 그걸로 불러주지."},

    {"key": "S008_D01", "value": "……새벽. 지낼 데는 있고?"},
    {"key": "S008_D02", "value": "……없습니다."},
    {"key": "S008_D03", "value": "그럴 줄 알았어. 비 맞은 똥강아지 꼴이구만."},
    {"key": "S008_D04", "value": "마침, 하나 부탁할 게 있어. 의뢰 하나 하지."},
    {"key": "S008_D05", "value": "폐상가 북쪽에 무너진 약국이 있어."},
    {"key": "S008_D06", "value": "거기 내가 두고 온 게 있어. 작은 철제 상자. ……급하게 나오느라 못 챙겼거든."},
    {"key": "S008_D07", "value": "그걸 회수해 와. 그럼 이 구역 건물 관리인한테 말 넣어주지. 빈 컨테이너 하나 내줄 거야."},
    {"key": "S008_C01", "value": "가져오겠습니다."},
    {"key": "S008_R01", "value": "기대는 안 해. ……그래도 살아서 와."},
    {"key": "S008_C02", "value": "그 상자, 뭡니까?"},
    {"key": "S008_R02", "value": "너무 많이 알려 하지 마."},
    {"key": "S008_R03", "value": "모르는 게 약이라는 말이 있지. 잔말 말고 다녀와."},

    {"key": "S009_N01", "value": "이 넓은 지역에서 찾아야 하나.... 조심해야겠군."},
    {"key": "S009_N02", "value": "이게 그 상자군... 대체 뭐길래..."},

    {"key": "S010_D01", "value": "……돌아왔군. 이건가?"},
    {"key": "S010_D02", "value": "……."},
    {"key": "S010_D03", "value": "그래. ……수고했어."},
    {"key": "S010_C01", "value": "(말없이 기다린다)"},
    {"key": "S010_R01", "value": "……뭘 기대하는 거야?"},
    {"key": "S010_C02", "value": "내용물은 확인 안 합니까?"},
    {"key": "S010_R02", "value": "볼 필요 없어. 난 뭐가 들었는지 아니까."},
    {"key": "S010_R03", "value": "……너는 관심 갖지 마."},
    {"key": "S010_D04", "value": "보상을 줘야겠지. 건물 관리인한테 말은 넣어놨어."},
    {"key": "S010_D05", "value": "저 안쪽, 컨테이너 사이에 장부 끼고 서 있는 여자 보이지. 이 구역 관리인이야."},
    {"key": "S010_D06", "value": "가서 '새벽'이라고 해. 빈 데 컨테이너 하나 내줄 거다."},
    {"key": "S010_D07", "value": "……텃세 좀 부려도 참아. 원래 그런 인간이니까."},
    {"key": "S010_D08", "value": "……뭐야. 못 보던 낯짝인데."},
    {"key": "S010_D09", "value": "새벽입니다. 회수꾼이 보냈습니다."},
    {"key": "S010_D10", "value": "아—. 그 게시판 늙은이가 말한 게 너구만."},
    {"key": "S010_D11", "value": "흠…… 비 쫄딱 맞고. 꼴 보니 갈 데도 없겠어."},
    {"key": "S010_D12", "value": "빈 거 하나 있어. 저 끝, 골판짝 컨테이너. 문은 안 잠겨."},
    {"key": "S010_D13", "value": "비 새는 데는 알아서 막고, 안에 굴러다니는 잡동사니는 네가 치워."},
    {"key": "S010_C03", "value": "얼맙니까."},
    {"key": "S010_R04", "value": "공짜는 없지. ……근데 그 늙은이 부탁이니."},
    {"key": "S010_R05", "value": "자릿세는 나중에 후불로. 벌어서 갚든, 일해서 갚든."},
    {"key": "S010_C04", "value": "왜 그냥 내줍니까."},
    {"key": "S010_R06", "value": "그냥은 아니야. 빚으로 달아두는 거지."},
    {"key": "S010_R07", "value": "여기선 공짜로 받은 게 제일 비싸. ……기억해 둬."},
    {"key": "S010_D14", "value": "규칙 하나만. 남의 물건에 손대지 마."},
    {"key": "S010_D15", "value": "여기의 규칙이야. ……알아들어?"},
    {"key": "S010_D16", "value": "……예."},
    {"key": "S010_D17", "value": "가 봐. 비 다 새기 전에."},
    {"key": "S010_N01", "value": "지붕이 생겼다. 비 새는 골판짝이지만."},
    {"key": "S010_N02", "value": "……없는 것보단 낫지."},

    {"key": "S011_N01", "value": "좁고, 눅눅하다. ……그래도 문은 닫힌다."},
    {"key": "S011_N02", "value": "쓸 만한 건 창고에 넣고…… 쓰레기는 버리자. 가방은 좁으니까."},
    {"key": "S011_N03", "value": "……배가 고프다. 목도 마르고."},
    {"key": "S011_N04", "value": "뭐라도 먹고 마실 게 필요해.."},

    {"key": "S012_D01", "value": "오, 새 얼굴이네. ……관리인이 새로 들인 친구구만?"},
    {"key": "S012_D02", "value": "뭐 필요한 거 있어? 없는 거 빼곤 다 있어. ……값만 맞으면."},
    {"key": "S012_D03", "value": "물이랑…… 먹을 거 있습니까?"},
    {"key": "S012_D04", "value": "암, 그게 제일 잘 나가지. 산 사람은 먹고 마셔야 하니까."},
    {"key": "S012_D05", "value": "근데 미리 말해두는데, 내 물건은 좀 비싸. 발품값이라고 생각해."},
    {"key": "S012_C01", "value": "왜 이렇게 비쌉니까."},
    {"key": "S012_R01", "value": "이 동네까지 이걸 끌고 온 사람이 나 말고 또 있나?"},
    {"key": "S012_R02", "value": "싫으면 사지 마."},
    {"key": "S012_C02", "value": "지역 상점은 없습니까?"},
    {"key": "S012_R03", "value": "하, 상점? 그건 이름값 있는 놈들 얘기지."},
    {"key": "S012_R04", "value": "네가 이 바닥에서 좀 알려지면, 저 닫힌 가게들도 셔터 올릴 거야."},
    {"key": "S012_D06", "value": "자, 골라. 정크로 받는다. 나도 양심은 있어서 루디는 안 받아."},
    {"key": "S012_D07", "value": "그런 귀한 것까지 교환할 물건까진 없어."},
    {"key": "S012_N01", "value": "……이제 좀 살 것 같군."},
    {"key": "S012_N02", "value": "이게 며칠이나 갈지는 모르겠지만."},
    {"key": "S012_D08", "value": "살아서 보자고."},

    {"key": "S013_D01", "value": "낯빛이 좀 폈네. 잠은 좀 잤고?"},
    {"key": "S013_D02", "value": "……마침 잘 왔어. 너에게 적당한 의뢰서 하나가 생겼어."},
    {"key": "S013_NOTE", "value": "[불을 꺼뜨리지 말아 주세요]\n\n날마다, 창가에 랜턴을 하나 켜 둡니다. 그 사람이 돌아오는 길을 잃지 않도록요.\n떠나기 전, 그는 이 불빛을 보고 돌아오겠다고 했습니다. 그래서 아무리 늦은 밤에도, 한 번도 불을 꺼뜨리지 않았습니다.\n하지만 요즘 랜턴의 빛이 자꾸 약해집니다. 안에 들어 있는 전력체가 거의 수명을 다한 것 같습니다.\n아직 사용할 수 있는 전력체를 하나만 구해다 주세요. 새것이 아니어도 괜찮습니다.\n혹시 그가 돌아오는 날, 이곳이 어두워 그냥 지나쳐 버릴까 봐 두렵습니다.\n부디, 이 불이 꺼지기 전에 부탁드립니다.\n\n- 익명 -"},
    {"key": "S013_D03", "value": "잘 들어 둬. 두 번은 안 말해."},
    {"key": "S013_D04", "value": "사람들은 '밤'이라고 부르지. 근데 그건 말이 그런 거야."},
    {"key": "S013_D05", "value": "밤이라서 위험한 게 아니라 — '짙은 현상'이 깔려서 컴컴해진 거다. 한낮에도 와."},
    {"key": "S013_D06", "value": "그게 언제 어디로 번질지 아무도 몰라. 멀쩡하던 골목이 순식간에 먹혀."},
    {"key": "S013_D07", "value": "그 안에 갇히면…… 못 나온다."},
    {"key": "S013_D08", "value": "그래서 이걸 줄게. 현상 계측기. 딱 한 번 쓰는 거다."},
    {"key": "S013_D09", "value": "짙은 현상이 가까워질수록 아이콘이 반짝여. 삑삑대면 — 곧 온다는 뜻이야."},
    {"key": "S013_D10", "value": "들어가기 전이든 안에서든, 단 한 번. 신중하게 써."},
    {"key": "S013_C01", "value": "짙은 현상이…… 뭡니까?"},
    {"key": "S013_R01", "value": "나도 다 몰라. 도시를 갉아먹는 거, 그 정도만 알지."},
    {"key": "S013_R02", "value": "확실한 건 하나야 — 오래 닿으면 사람이 안 돌아와. 그러니 빨리 빠져나와."},
    {"key": "S013_C02", "value": "그 안에선 뭘 조심합니까?"},
    {"key": "S013_R03", "value": "셋만 기억해. 하나 — 랜턴 전력체. 닳으면 빛이 죽고, 그 자리서 장님 된다."},
    {"key": "S013_R04", "value": "둘 — 시간. 현상이 깔려 있는 동안이 제일 위험해. 루디도 딱 그때만 나오고."},
    {"key": "S013_R05", "value": "셋 — 소리. 뛰면 들켜. 급할 때 아니면 살살 움직여."},
    {"key": "S013_R06", "value": "그리고 — 한 군데서 너무 오래 죽치지 마. 욕심부리다 못 나온 놈 많다."},
    {"key": "S013_C03", "value": "전력체라는 게…… 루디 말입니까?"},
    {"key": "S013_R07", "value": "그래. 빛나는 돌. 전기 끊긴 세상에서 뭐든 돌아가게 하는 건 그거뿐이지."},
    {"key": "S013_R08", "value": "현상 속에서만 나와. 하나 구해다 그 집 창가에 꽂아주면 의뢰는 끝이고."},
    {"key": "S013_R09", "value": "……남는 게 있으면 전당포 영감한테. 그 양반이 사들이니까."},
    {"key": "S013_R10", "value": "그 의뢰 — 영감이 유독 신경 쓰더라. 이유는 안 물었다."},
    {"key": "S013_D11", "value": "랜턴이랑 여분 전력체는 챙겼지? 계측기도 잊지 말고."},
    {"key": "S013_D12", "value": "……살아서 와. 시체 치우는 것도 일이거든."},
    {"key": "S013_N06", "value": "……저 안에, 그게 있다는 거군."},
    {"key": "S013_N07", "value": "계측기 하나에…… 목숨을 맡겨야 하나."},

    {"key": "S016_N01", "value": "무너진 매대 더미 안쪽에서 희미한 소리가 들린다."},
    {"key": "S016_D01", "value": "거기… 누구 있어요? 제발, 누구든……"},
    {"key": "S016_D02", "value": "매대가 무너지면서 다리가 깔렸어요. 혼자선 못 빠져나가요."},
    {"key": "S016_C01", "value": "조금만 버텨요. 빼줄게."},
    {"key": "S016_R01", "value": "고, 고마워요… 정말……"},
    {"key": "S016_C02", "value": "…내가 왜?"},
    {"key": "S016_R02", "value": "부탁이에요. 가진 거 전부 드릴게요."},
    {"key": "S016_R03", "value": "여기서 이렇게 죽고 싶지 않아요."},
    {"key": "S016_N02", "value": "깔린 잔해를 힘껏 밀어낸다. 먼지 속에서 사람을 끌어낸다."},
    {"key": "S016_D03", "value": "살았다…… 정말 고마워요."},
    {"key": "S016_D04", "value": "이거 받아요. 얼마 안 되지만, 내가 줄 수 있는 전부예요."},
    {"key": "S016_D05", "value": "나는 사람들이 모여 산다는 곳으로 갈 거예요. '침묵 생활 지구'… 거기엔 아직 사람이 있대요."},

    {"key": "S017_D01", "value": "거기 서. 여긴 우리 구역이야."},
    {"key": "S017_D02", "value": "지나가고 싶으면 통행료가 있어. 알지?"},
    {"key": "S017_C01", "value": "얼마면 되지?"},
    {"key": "S017_R01", "value": "말이 통하는 놈이군. 좋아, 흥정해보자고."},
    {"key": "S017_C02", "value": "비켜. 두 번 말 안 한다."},
    {"key": "S017_R02", "value": "…허, 배짱 좋네."},
    {"key": "S017_R03", "value": "후회하게 만들지 마. 우린 숫자가 많아."},
    {"key": "S017_D03", "value": "(그는 길을 반쯤 비켜선다) 다음엔 빈손으로 오지 마."},

    {"key": "S020_N01", "value": "……낮의 그 폐상가가 맞나."},
    {"key": "S020_N02", "value": "빛이 닿는 데까지만…… 내 세상이군."},
    {"key": "S020_N03", "value": "같은 장소인데 완전히 다르다."},

    {"key": "S022_N01", "value": "낮엔 닫혀 있던 문이…… 밤이 되니 열렸다."},

    {"key": "S023_N01", "value": "……시계가 멈췄다."},
    {"key": "S023_N02", "value": "멈춘 건 시계가 아니야. 주변이 멈춘 건가?"},
    {"key": "S023_N03", "value": "뭐야 저건…… 뭔가 말하고 있다. 안 들려."},
    {"key": "S023_N04", "value": "사라졌다. 루디를 만졌을 때부터——"},
    {"key": "S023_N05", "value": "돌아가서 물어봐야겠다."},

    {"key": "S024_N01", "value": "……일단, 살아서 나가자."},

    {"key": "S030_D01", "value": "왔군. 뭐 가져왔어?"},
    {"key": "S030_D02", "value": "이것…… 루디입니까?"},
    {"key": "S030_D03", "value": "진짜네. 처음 밤에 살아 돌아온 것도 대단한데."},
    {"key": "S030_D04", "value": "이상한 일이 있었습니다. 시계가 멈추고, 그림자를 봤습니다."},
    {"key": "S030_D05", "value": "……시계가 반응했다고?"},
    {"key": "S030_C01", "value": "무슨 뜻입니까?"},
    {"key": "S030_R01", "value": "그 시계, 보통 시계가 아니야."},
    {"key": "S030_R02", "value": "반응했다는 건 너도 보통이 아니라는 뜻이고."},
    {"key": "S030_R03", "value": "더는…… 아직 안 돼."},
    {"key": "S030_C02", "value": "그림자가 뭔가 말하려는 것 같았습니다."},
    {"key": "S030_R04", "value": "다음에 또 그런 일 있으면, 도망치지 마."},
    {"key": "S030_R05", "value": "위험하긴 한데…… 너한테 중요한 거일 수도 있어."},
    {"key": "S030_D06", "value": "일단 잘했어. 이제 여기서 정식으로 거래할 수 있어."},
    {"key": "S030_D07", "value": "시계는 절대 빼지 마."},
    {"key": "S030_D08", "value": "오늘은 쉬어. 내일부터 본격적으로 시작이야."},

    {"key": "S031_N01", "value": "……."},
    {"key": "S031_N02", "value": "누군가 부르는 소리가 들린다."},
    {"key": "S031_N03", "value": "작은 목소리. 어린아이 같은."},
    {"key": "S031_N04", "value": "뭐라고 하는지 안 들려."},
    {"key": "S031_D01", "value": "……살아 있으려나."},
    {"key": "S031_D02", "value": "……! 일어났어?"},
    {"key": "S031_D03", "value": "아무것도 아니야. 잠꼬대."},
    {"key": "S031_D04", "value": "누가 살아 있냐고요?"},
    {"key": "S031_D05", "value": "……."},
    {"key": "S031_D06", "value": "루디를 더 가져와."},
    {"key": "S031_D07", "value": "그러면 말해줄 수 있는 것부터 알려줄게."},
    {"key": "S031_D08", "value": "……순서가 있어."},
    {"key": "S031_N05", "value": "그 남자는 뭔가를 알고 있다."},
    {"key": "S031_N06", "value": "내 과거. 그리고 누군가의 이름."},
    {"key": "S031_N07", "value": "알아내려면…… 계속 나가야 한다."},

    {"key": "UI_REPUTATION_GET", "value": "평판을 얻었습니다 — 게시판에 새 의뢰가 열릴 수 있습니다."},
    {"key": "UI_HOME_UNLOCKED", "value": "거처를 얻었습니다 — 컨테이너 은신처."},
    {"key": "UI_HP_RECOVERED", "value": "체력·기력이 회복되었습니다. 허기·수분이 줄었습니다."},
    {"key": "UI_RUDI_GET", "value": "루디 조각을 획득했습니다."},
    {"key": "UI_DAILY_UNLOCKED", "value": "폐상가 교역 지구를 자유롭게 탐색할 수 있습니다."},
    {"key": "UI_MAP_LOCKED", "value": "거긴 아직 위험해. 좀 더 준비하고."}
  ]
}
