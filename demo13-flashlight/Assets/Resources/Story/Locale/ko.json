{
  "entries": [
    {"key": "NPC_PAWNSHOP", "value": "전당포 주인"},
    {"key": "NPC_PLAYER", "value": "주인공"},
    {"key": "NPC_MERCHANT", "value": "떠돌이 상인"},
    {"key": "NPC_BANDIT", "value": "밴딧 잔당"},

    {"key": "S000_N01", "value": "……머리가 아프다."},
    {"key": "S000_N02", "value": "여기가 어디지?"},

    {"key": "S002_D01", "value": "이 시간에, 이 날씨에?"},
    {"key": "S002_D02", "value": "뭐 팔러 왔어?"},
    {"key": "S002_D03", "value": "이 시계…… 맡길 수 있습니까?"},
    {"key": "S002_D04", "value": "…….\n이 시계, 어디서 났어?"},
    {"key": "S002_D05", "value": "골목에서 쓰러져 있었습니다. 기억이 없어요."},
    {"key": "S002_D06", "value": "…너, 살아 있었냐."},
    {"key": "S002_D07", "value": "저를 아십니까?"},
    {"key": "S002_D08", "value": "아는 정도가 아니지."},
    {"key": "S002_D09", "value": "시계는 맡기지 마. 그건 네가 갖고 있어야 해."},
    {"key": "S002_D10", "value": "이유는…… 나중에."},

    {"key": "S003_D01", "value": "기억 없고, 돈 없고, 갈 데 없고. 맞지?"},
    {"key": "S003_D02", "value": "……네."},
    {"key": "S003_D03", "value": "간단하게 알려줄게."},
    {"key": "S003_D04", "value": "이게 루디. 전기 끊긴 뒤로 유일한 에너지원이야."},
    {"key": "S003_D05", "value": "밤이 되면 도시가 이상해져. '짙은 현상'이라고 불러."},
    {"key": "S003_D06", "value": "위험하지만 루디는 거기서만 나와."},
    {"key": "S003_D07", "value": "네가 루디를 가져오면, 여기서 거래할 수 있게 해줄게."},
    {"key": "S003_D08", "value": "그리고 네 과거에 대해서도 아는 것부터 알려줄게."},

    {"key": "S003_C01", "value": "해보겠습니다."},
    {"key": "S003_C02", "value": "왜 저한테 시키는 겁니까?"},
    {"key": "S003_R01", "value": "좋아. 일단 살아서 돌아오는 게 가장 중요해."},
    {"key": "S003_R02", "value": "너라서 시키는 거야."},
    {"key": "S003_R03", "value": "이유는 아직 못 말해. 그 시계랑 관련이 있어."},

    {"key": "S004_D01", "value": "여기가 네 거처야. 화려하진 않지만 비는 안 새."},
    {"key": "S004_D02", "value": "침대에서 자면 몸이 좀 나을 거야."},
    {"key": "S004_D03", "value": "준비되면 지도판에서 지역을 골라."},

    {"key": "S005_N01", "value": "루디, 짙은 현상, 밤."},
    {"key": "S005_N02", "value": "가야 할 이유는 충분하다."},

    {"key": "TUT_MOVE", "value": "WASD — 이동"},
    {"key": "TUT_PICKUP", "value": "E — 줍기"},
    {"key": "TUT_INVENTORY", "value": "Tab — 인벤토리"},
    {"key": "TUT_REST", "value": "침대에서 휴식 → HP 회복"},
    {"key": "TUT_EQUIP", "value": "장비를 장착하세요. 지도판에서 출전할 지역을 선택하세요."},
    {"key": "TUT_SEARCH", "value": "E — 수색"},
    {"key": "TUT_COMBAT", "value": "좌클릭 — 약공격 / 우클릭(홀드) — 강공격 / Space — 구르기"},
    {"key": "TUT_FLASHLIGHT", "value": "F — 손전등 ON/OFF"},
    {"key": "TUT_HELP", "value": "H — 조작법 보기"},

    {"key": "S010_N01", "value": "폐상가…… 다 부서지고 방치되어 있다."},
    {"key": "S010_N02", "value": "뭔가 쓸 만한 게 있을 수도 있겠다."},

    {"key": "S011_N01", "value": "가방이 작으니까 잘 골라야겠다."},

    {"key": "S012_D01", "value": "멈춰."},
    {"key": "S012_D02", "value": "밴딧은 아닌 것 같고. 뭘 원해?"},
    {"key": "S012_C01", "value": "거래할 수 있습니까?"},
    {"key": "S012_C02", "value": "이 근처 정보 좀 알려주실 수 있습니까?"},
    {"key": "S012_R01", "value": "좋아. 있는 건 보여줄게."},
    {"key": "S012_R02", "value": "근데 싸게는 안 팔아."},
    {"key": "S012_R03", "value": "신참 같아서 알려주는 거야."},
    {"key": "S012_R04", "value": "이 골목 더 안쪽에 아직 안 털린 편의점 있어."},
    {"key": "S012_R05", "value": "대로 말고 뒷길로 돌아가면 밴딧도 안 만나."},
    {"key": "S012_D03", "value": "밤에는 여기 오지 마."},
    {"key": "S012_D04", "value": "올 거면 손전등 챙겨."},

    {"key": "S013_D01", "value": "이봐, 물건 놓고 가."},
    {"key": "S013_N01", "value": "살아 있으니까 싸울 수밖에 없다."},

    {"key": "S014_NOTE", "value": "밤이 되면 이 골목 끝 지하창고 문이 열린다.\n안에 빛나는 게 있다.\n나갈 때는 후문으로. 정문은 밤에 밴딧이 지킨다.  — K"},
    {"key": "S014_N01", "value": "지하창고…… 밤에만 열린다고?"},
    {"key": "S014_N02", "value": "루디인가. 기억해두자."},

    {"key": "S015_D01", "value": "돌아왔군. 어땠어?"},
    {"key": "S015_D02", "value": "밴딧이 있었습니다."},
    {"key": "S015_D03", "value": "살아서 온 게 제일 중요해."},
    {"key": "S015_D04", "value": "하지만 루디는 밤에 가야 나와."},
    {"key": "S015_D05", "value": "준비되면 밤으로 나가봐."},

    {"key": "S020_D01", "value": "밤이구나. 조심해."},
    {"key": "S020_D02", "value": "손전등 배터리가 다 되면 앞이 안 보여."},
    {"key": "S020_D03", "value": "안에 있을 수 있는 시간은 15분. 넘기면 현상이 강해져."},
    {"key": "S020_C01", "value": "알겠습니다."},
    {"key": "S020_C02", "value": "무서우면 안 됩니까?"},
    {"key": "S020_R01", "value": "……다녀와."},
    {"key": "S020_R02", "value": "무서운 게 정상이야. 무섭지 않은 놈이 먼저 죽어."},
    {"key": "S020_R03", "value": "……다녀와."},

    {"key": "S021_N01", "value": "같은 장소인데 완전히 다르다."},

    {"key": "S022_N01", "value": "쪽지에 있던 그 문이다. 낮에는 없었는데."},

    {"key": "S023_N01", "value": "……시계가 멈췄다."},
    {"key": "S023_N02", "value": "멈춘 건 시계가 아니야. 주변이 멈춘 건가?"},
    {"key": "S023_N03", "value": "뭐야 저건…… 뭔가 말하고 있다. 안 들려."},
    {"key": "S023_N04", "value": "사라졌다. 루디를 만졌을 때부터——"},
    {"key": "S023_N05", "value": "돌아가서 물어봐야겠다."},

    {"key": "S030_D01", "value": "왔군. 뭐 가져왔어?"},
    {"key": "S030_D02", "value": "이것…… 루디입니까?"},
    {"key": "S030_D03", "value": "진짜네. 처음 밤에 살아 돌아온 것도 대단한데."},
    {"key": "S030_D04", "value": "이상한 일이 있었습니다. 시계가 멈추고, 그림자를 봤습니다."},
    {"key": "S030_D05", "value": "……시계가 반응했다고?"},
    {"key": "S030_C01", "value": "무슨 뜻입니까?"},
    {"key": "S030_C02", "value": "그림자가 뭔가 말하려는 것 같았습니다."},
    {"key": "S030_R01", "value": "그 시계, 보통 시계가 아니야."},
    {"key": "S030_R02", "value": "반응했다는 건 너도 보통이 아니라는 뜻이고."},
    {"key": "S030_R03", "value": "더는…… 아직 안 돼."},
    {"key": "S030_R04", "value": "다음에 또 그런 일 있으면, 도망치지 마."},
    {"key": "S030_R05", "value": "위험하긴 한데…… 너한테 중요한 거일 수도 있어."},
    {"key": "S030_D06", "value": "일단 잘했어. 이제 여기서 정식으로 거래할 수 있어."},
    {"key": "S030_D07", "value": "시계는 절대 빼지 마."},
    {"key": "S030_D08", "value": "오늘은 쉬어. 내일부터 본격적으로 시작이야."},

    {"key": "S031_N01", "value": "……."},
    {"key": "S031_N02", "value": "누군가 부르는 소리가 들린다."},
    {"key": "S031_N03", "value": "작은 목소리. 어린아이 같은."},
    {"key": "S031_N04", "value": "뭐라고 하는지 안 들려."},
    {"key": "S031_D01", "value": "……살아 있으려나."},
    {"key": "S031_D02", "value": "……! 일어났어?"},
    {"key": "S031_D03", "value": "아무것도 아니야. 잠꼬대."},
    {"key": "S031_D04", "value": "누가 살아 있냐고요?"},
    {"key": "S031_D05", "value": "……."},
    {"key": "S031_D06", "value": "루디를 더 가져와."},
    {"key": "S031_D07", "value": "그러면 말해줄 수 있는 것부터 알려줄게."},
    {"key": "S031_D08", "value": "……순서가 있어."},
    {"key": "S031_N05", "value": "그 남자는 뭔가를 알고 있다."},
    {"key": "S031_N06", "value": "내 과거. 그리고 누군가의 이름."},
    {"key": "S031_N07", "value": "알아내려면…… 계속 나가야 한다."},

    {"key": "UI_SAFEHOUSE_ARRIVE", "value": "안전가옥에 도착했습니다."},
    {"key": "UI_HP_RECOVERED", "value": "HP가 회복되었습니다."},
