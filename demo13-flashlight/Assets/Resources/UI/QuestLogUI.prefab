  m_Text: "<b><color=#DBBC6B>\uB0A1\uC740 \uBD80\uD488 \uB9E4\uC785</color></b> 
    <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uAE30\uACC4\xB7\uCE21\uC815\uC6A9
    \uBD80\uD488 \uB450 \uAC1C\uAC00 \uD544\uC694\uD558\uB2E4. \uC4F8 \uB9CC\uD55C
    \uAC78\uB85C \uACE8\uB77C \uC640.</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n 
    <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uACF5\uAD6C \uBD80\uD488 2\uAC1C
    \uC218\uC9D1 (0/2)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527
    \xD711000, wire \xD72</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED:
    scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
