  m_Text: "<b><color=#DBBC6B>\uCC3D\uACE0 \uC18C\uB9AC \uC870\uC0AC</color></b>  <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uCC3D\uACE0\uC5D0\uC11C \uBC24\uB9C8\uB2E4 \uC18C\uB9AC\uAC00 \uB098\uC624. \uD55C \uBC88 \uC0B4\uD3B4\uBD10 \uC8FC\uC624.\n\u2014 \uCC3D\uACE0\uC9C0\uAE30</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n  <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uCC3D\uACE0 \uC778\uADFC \uC870\uC0AC (0/1)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527 \xD72500, map_fragment \xD71</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED: scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
