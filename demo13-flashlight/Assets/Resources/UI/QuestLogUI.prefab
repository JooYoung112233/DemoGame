  m_Text: "<b><color=#DBBC6B>\uAC10\uC815 \uC758\uB8B0</color></b>  <color=#FF8C73>\u25CF
    \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC815\uCCB4\uBD88\uBA85\uC758 \uC7A5\uBB3C
    \uD55C \uC810\uC744 \uD68C\uC218\uD574 \uC624\uB77C. \uC804\uB2F9\uD3EC\uC5D0\uC11C
    \uAC10\uC815\uD574 \uC8FC\uACA0\uB2E4.</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n 
