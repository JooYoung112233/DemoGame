  m_Text: "<b><color=#DBBC6B>\uADC0\uC911\uD488 \uB9E4\uC785</color></b>  <color=#FF8C73>\u25CF
    \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC804\uB2F9\uD3EC \uC8FC\uC778\uC774 \uC0AC\uB4E4\uC77C
    \uADC0\uC911\uD488 \uD55C \uC810\uC744 \uAC00\uC838\uC624\uB77C. \uAC12\uC740
    \uC81C\uB300\uB85C \uCCD0\uC8FC\uACA0\uB2E4\uACE0 \uD55C\uB2E4.</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n 
    <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uADC0\uC911\uD488 1\uC810 \uB0A9\uD488
    (0/1)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527
    \xD712000, \uC2E0\uB8B0 +1</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED:
    scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
