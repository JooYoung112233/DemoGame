  m_Text: "<b><color=#DBBC6B>\uD76C\uADC0\uD488 \uC0AC\uB4E4\uC784</color></b>  <color=#FF8C73>\u25CF
    \uC2E0\uADDC</color>\n<color=#EBE5D6>\uD76C\uADC0\uD55C \uBB3C\uAC74\uC774 \uB4E4\uC5B4\uC654\uB2E4\uB294
