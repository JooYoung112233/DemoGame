  m_Text: "<b><color=#DBBC6B>\uAC70\uCE5C \uB188 \uD558\uB098</color></b>  <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC720\uB09C\uD788 \uC0AC\uB098\uC6B4 \uB188 \uD558\uB098\uAC00 \uC0AC\uB78C\uC744 \uD574\uCCE4\uC18C. \uADF8\uB188\uB9CC \uCC98\uB9AC\uD574 \uC8FC\uC624.\n\u2014 \uD53C\uD574\uC790 \uAC00\uC871</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n  <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uC815\uC608 \uBC34\uB527 x1 \uCC98\uCE58 (0/1)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527 \xD77000, knife \xD71, coat_light \xD71</color>"
