  m_Text: "<b><color=#DBBC6B>\uADC0\uC911\uD488 \uB9E4\uC785</color></b>  <color=#FF8C73>\u25CF
    \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC804\uB2F9\uD3EC \uC8FC\uC778\uC774 \uC0AC\uB4E4\uC77C
