  m_Text: "<b><color=#DBBC6B>\uB8E8\uB514 \uB2E4\uB7C9 \uB0A9\uD488</color></b> 
    <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uD070 \uAC70\uB798\uB2E4.
    \uB8E8\uB514 \uC870\uAC01 \uC14B\uC744 \uBAA8\uC544 \uC624\uBA74 \uD2B9\uBCC4\uD788
    \uB354 \uCCD0\uC8FC\uACA0\uB2E4.</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n 
    <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uB8E8\uB514 \uC870\uAC01 3\uAC1C
    \uB0A9\uD488 (0/3)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527
    \xD750000, \uD638\uAC10 +5</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED:
    scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
