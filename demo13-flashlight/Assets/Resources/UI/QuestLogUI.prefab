  m_Text: "<b><color=#DBBC6B>\uC7AC\uACE0 \uBCF4\uCDA9</color></b>  <color=#FF8C73>\u25CF
    \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC7AC\uD310\uB9E4\uC6A9 \uC18C\uBAA8\uD488
    \uC7AC\uACE0\uAC00 \uB5A8\uC5B4\uC84C\uB2E4. \uBD95\uB300 \uC138 \uAC1C\uB9CC
    \uCC44\uC6CC\uB2E4 \uC8FC\uBA74 \uAC12\uC744 \uCE58\uB974\uACA0\uB2E4.</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n 
    <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uBD95\uB300 3\uAC1C \uC218\uC9D1
    (0/3)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527
    \xD710000, canned_food \xD72</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED:
    scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
