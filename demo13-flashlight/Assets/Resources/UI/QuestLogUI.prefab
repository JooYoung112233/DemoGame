  m_Text: "<b><color=#DBBC6B>\uBD84\uC2E4\uBB3C\uC744 \uCC3E\uC18C</color></b>  <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC774\uB984 \uC801\uD78C \uBA85\uD328\uB97C \uC783\uC5C8\uC18C. \uAC12\uC740 \uC548 \uB530\uC9C8 \uD14C\uB2C8 \uAF2D \uCC3E\uC544 \uC8FC\uC624.\n(\uC11C\uBA85 \uC5C6\uC74C)</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n  <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uC774\uB984 \uC801\uD78C \uBA85\uD328 x1 \uB0A9\uD488 (0/1)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527 \xD77000, \uC2E0\uB8B0 +1</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED: scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
