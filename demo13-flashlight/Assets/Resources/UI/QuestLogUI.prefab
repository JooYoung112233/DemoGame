  m_Text: "<b><color=#DBBC6B>\uAE30\uACC4 \uBD80\uD488 \uAD6C\uD568</color></b>  <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC218\uB9AC\uD560 \uBB3C\uAC74\uC774 \uBC00\uB838\uC18C. \uBD80\uD488 \uC138 \uAC1C\uB9CC \uB9DE\uCDB0\uB2E4 \uC8FC\uC624.\n\u2014 \uACE8\uBAA9 \uC218\uB9AC\uC7C1\uC774</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n  <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uACF5\uAD6C \uBD80\uD488 x3 \uB0A9\uD488 (0/3)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527 \xD77000, repair_kit \xD71</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED: scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
