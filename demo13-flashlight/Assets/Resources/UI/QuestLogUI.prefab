  m_Text: "<b><color=#DBBC6B>\uBB34\uB108\uC9C4 \uC0C1\uC810</color></b>  <color=#FF8C73>\u25CF \uC2E0\uADDC</color>\n<color=#EBE5D6>\uC61B \uC0C1\uC810\uC774 \uBB34\uB108\uC84C\uB2E4\uB294\uB370, \uC548\uC774 \uAD81\uAE08\uD558\uC624. \uD55C \uBC88 \uB458\uB7EC\uBD10 \uC8FC\uC624.\n\u2014 \uD638\uC0AC\uAC00</color>\n\n<color=#8A8270>\uBAA9\uD45C</color>\n  <color=#CCCCCC>\u2610</color> <color=#CCCCCC>\uBD95\uAD34 \uC0C1\uC810 \uC870\uC0AC (0/1)</color>\n\n<color=#8A8270>\uBCF4\uC0C1</color>\n<color=#EBE5D6>\uD06C\uB808\uB527 \xD72500</color>\n\n<color=#665F52>[\uCCA8\uBD80] \uC9C0\uC5ED: scrap_market \xB7 \uC9C0\uB3C4 \uCCA8\uBD80</color>"
